# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=jobsearch
POSTGRES_DB=jobsearch
DATABASE_URL=postgresql://jobsearch:jobsearch@localhost:5432/jobsearch

# API server
API_PORT=3000

# Login. JWT_SECRET signs the session cookie: use a long random string, for example the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the API uses a development-only secret (and refuses to start in production).
JWT_SECRET=
# Set to false to stop new sign-ups (the first account to sign up is the admin).
ALLOW_SIGNUP=true
# Where the frontends run. Only these origins may call the API with the session cookie.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:6006

# JobsPipe (used from step 2). Keep this secret.
JOBSPIPE_API_URL=https://api.jobspipe.dev/v1
JOBSPIPE_API_TOKEN=

# Resume-Matcher (`pnpm rm:up`): our API calls it to tailor your resume and score each job.
# Leave RESUME_MATCHER_URL empty to switch the feature off.
RESUME_MATCHER_URL=http://localhost:3100
# Its AI provider. Create a key at console.anthropic.com (Settings > API Keys). Keep this secret.
# After changing any of these, run `pnpm rm:up` again so the container picks them up.
ANTHROPIC_API_KEY=
RM_LLM_PROVIDER=anthropic
RM_LLM_MODEL=claude-sonnet-5-5
# Free local option instead: RM_LLM_PROVIDER=ollama, RM_LLM_MODEL=gemma3:4b and
# RM_LLM_API_BASE=http://host.docker.internal:11434 (Ollama must be running on your PC).
RM_LLM_API_BASE=

# PDF templates (`pnpm pdf:up`): turns resumes and cover letters into PDFs in the template you
# pick on My profile. Leave empty, or don't start it, and downloads are plain PDFs instead.
PDF_RENDERER_URL=http://localhost:8090

# Scheduled imports: the most credits all imports may use per day before scheduled runs are
# skipped (manual imports still work). Set SCHEDULER_ENABLED=false to switch the scheduler off.
DAILY_CREDIT_CAP=100
SCHEDULER_ENABLED=true

# Separate database for `pnpm test:e2e` (tables are wiped between tests).
TEST_DATABASE_URL=postgresql://jobsearch:jobsearch@localhost:5432/jobsearch_test
