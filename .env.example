# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=jobsearch
POSTGRES_DB=jobsearch
DATABASE_URL=postgresql://jobsearch:jobsearch@localhost:5432/jobsearch

# API server
API_PORT=3000

# JobsPipe (used from step 2). Keep this secret.
JOBSPIPE_API_URL=https://api.jobspipe.dev/v1
JOBSPIPE_API_TOKEN=
