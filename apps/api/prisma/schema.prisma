// Database schema. After editing, run `pnpm --filter @jobsearch/api db:migrate` to create a migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Where a job came from.
enum JobSource {
  JOBHUNTER
  MANUAL
  /// The German Federal Employment Agency's job board (free).
  ARBEITSAGENTUR
  /// A company's own career page (Greenhouse, Lever or Ashby).
  COMPANY_BOARD
}

/// Where a saved search or import looks for jobs.
enum ImportSource {
  JOBHUNTER
  ARBEITSAGENTUR
  COMPANY_BOARDS
}

/// What the last "Is it still open?" check found when it opened the job's link.
enum PostingCheck {
  OPEN
  CLOSED
  /// The site blocked the check, timed out, or the page gave no clear answer.
  UNKNOWN
}

/// What a job ad says about visa sponsorship (or relocation help).
enum VisaSponsorship {
  OFFERS
  NO
  NOT_STATED
}

enum Workplace {
  ONSITE
  HYBRID
  REMOTE
}

/// Your own progress on a job. Separate from `postingStatus`, which is whether the ad is still open.
enum ApplicationStatus {
  NONE
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// ADMIN can import from JobHunter and manage saved searches (it spends the server's credits).
/// The first account to sign up becomes ADMIN; everyone after that is a USER.
enum Role {
  ADMIN
  USER
}

enum AiProvider {
  ANTHROPIC
  OPENAI
}

enum ApiKeyKind {
  /// JobHunter search token: imports use it and its credits.
  JOBHUNTER
  /// Claude Console key, for the AI score.
  ANTHROPIC
  /// OpenAI platform key, for the AI score.
  OPENAI
}

/// A user's own key for a paid service, so each person spends their own credits.
model ApiKey {
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  kind      ApiKeyKind
  /// Encrypted with AES-256-GCM, like Gmail tokens (api-keys.service.ts). Never returned by the API.
  secret    String
  /// The last 4 characters, so you can tell which key is saved.
  last4     String
  /// The AI model to use with this key, e.g. "claude-sonnet-5-5". Null for JobHunter.
  model     String?
  /// JobHunter credits left, as its last answer said.
  credits   Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([userId, kind])
}

model User {
  id                Int                   @id @default(autoincrement())
  email             String                @unique
  name              String
  /// argon2id hash. The password itself is never stored.
  passwordHash      String
  role              Role                  @default(USER)
  profile           Profile?
  languageResumes   LanguageResume[]
  resumeBuilds      ResumeBuild[]
  letterTemplates   CoverLetterTemplate[]
  stories           Story[]
  applicationEvents ApplicationEvent[]
  documentStyle     DocumentStyle?
  hiddenJobs        HiddenJob[]
  /// The jobs on your Job posts list: the ones you imported or added.
  listedJobs        UserJob[]
  applications      Application[]
  matcherResume     MatcherResume?
  jobMatches        JobMatch[]
  tailored          TailoredResume[]
  removedTerms      RemovedTerm[]
  jobResumes        JobResume[]
  interviewPreps    InterviewPrep[]
  gmailAccounts     GmailAccount[]
  mailSuggestions   MailSuggestion[]
  applyQueue        ApplyQueueItem[]
  jobFits           JobFit[]
  jobLanguages      JobLanguages[]
  savedAnswers      SavedAnswer[]
  tableSettings     TableSettings?
  notifications     Notification[]
  /// Your messages to the app's makers (Message Mohamed Faizel) and their answers.
  messages          Message[]
  /// When you last opened Job posts (any page load counts). A gap of 30+ minutes starts a new visit.
  jobsLastSeenAt    DateTime?
  /// Jobs imported after this are "New" for this visit: the end of your previous visit.
  jobsNewSince      DateTime?
  /// The language the app is shown in ("en" or "de"), so it follows you to other devices.
  locale            String                @default("en")
  /// Which AI the app uses for you: the AI score and the copy-and-open buttons.
  aiProvider        AiProvider            @default(ANTHROPIC)
  /// When you finished (or skipped) the first-login steps; null shows them after you log in.
  onboardedAt       DateTime?
  /// Set by an admin to stop this account logging in. Null = can log in. Nothing is deleted.
  disabledAt        DateTime?
  /// When this account last used the app (updated at most every few minutes), for Admin › Users.
  lastSeenAt        DateTime?
  apiKeys           ApiKey[]
  /// The JobHunter token lent to this user from the admins' Key pool, if any.
  poolKey           PoolKey?
  keyRequests       KeyRequest[]
  /// The old .env keys already copied into this account's Settings (first account only), so
  /// each is copied once and a key you delete stays deleted.
  adoptedEnvKeys    ApiKeyKind[]          @default([])
  savedSearches     SavedSearch[]
  syncRuns          SyncRun[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  pushTokens        PushToken[]
  googleCalendar    GoogleCalendar?
}

/// The Job posts filters and sort a user saved, as JSON text, so the table opens the way they left
/// it on any device. The shape is the web app's business; the API only keeps it.
model TableSettings {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings  String
  updatedAt DateTime @updatedAt
}

/// What you're looking for and your master resume. One per user, created on first save.
model Profile {
  userId              Int       @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline            String    @default("")
  targetRoles         String[]  @default([])
  locations           String[]  @default([])
  skills              String[]  @default([])
  /// Words from job ads that are true for you ("wcag", "code reviews"), ticked on the Fit tab.
  /// Counted as covered like skills, but kept apart so Skills stays a list of tools.
  keywords            String[]  @default([])
  /// Languages you speak with your real level, e.g. "German A2". Copied into the resume prompt.
  languages           String[]  @default([])
  yearsExperience     Int?
  linkedinUrl         String?
  githubUrl           String?
  websiteUrl          String?
  /// Plain text of your master resume, from an uploaded PDF/DOCX or typed in.
  resumeText          String    @default("")
  /// The language your master resume is written in (ISO 639-1, e.g. "en"). Resumes in other
  /// languages are in LanguageResume.
  resumeLanguage      String    @default("en")
  resumeFileName      String?
  /// The uploaded PDF/DOCX itself, kept so it can be sent to Resume-Matcher (max 5 MB).
  resumeFile          Bytes?
  resumeFileType      String?
  resumeUploadedAt    DateTime?
  // Personal details forms ask for. Empty = not given. User.name stays the display name;
  // saving a first and last name updates it.
  firstName           String    @default("")
  lastName            String    @default("")
  /// female, male, diverse or not_specified; empty = not given. Codes, so any language can
  /// show its own words.
  gender              String    @default("")
  /// ISO date "YYYY-MM-DD", empty = not given.
  dateOfBirth         String    @default("")
  nationality         String    @default("")
  // Application answers: the facts every application form asks for. The Apply kit copies them
  // into the Claude prompt and the page Claude in Chrome fills forms from. Empty = not given.
  phone               String    @default("")
  address             String    @default("")
  workPermit          String    @default("")
  noticePeriod        String    @default("")
  salaryExpectation   String    @default("")
  relocation          String    @default("")
  /// e.g. "Full-time".
  employmentType      String    @default("")
  /// e.g. "Remote or hybrid".
  workplacePreference String    @default("")
  /// e.g. "Class B".
  drivingLicence      String    @default("")
  /// Free text: short answers you reuse, like why you are looking for a new job.
  applicationNotes    String    @default("")
  /// Your achievements bank: true facts with numbers, one per line. Resume prompts may use
  /// them and the fact check trusts them.
  achievements        String    @default("")
  /// Resume settings: tailored resumes are at most this many pages (1, 2 or 3).
  resumeMaxPages      Int       @default(2)
  /// Tailored resumes keep every section heading of your resume, in your order.
  keepMySections      Boolean   @default(false)
  /// Tell me when a scheduled search finds new jobs with at least `matchFitMin` Fit %.
  notifyNewMatches    Boolean   @default(true)
  /// Fill Claude's questions (Ask me) from your saved answers by themselves.
  fillSavedAnswers    Boolean   @default(true)
  /// Show the Stretches (lines that may be hard to explain) of Claude's reply for a decision.
  showStretches       Boolean   @default(true)
  matchFitMin         Int       @default(60)
  /// Nightly apply kits: at night, write the resume, cover letter and form answers for queued
  /// jobs with your own AI key (Settings), so they are ready in the morning.
  nightlyKits         Boolean   @default(false)
  /// The most kits written in one night (each one costs a few cents on your key).
  nightlyKitsMax      Int       @default(5)
  /// Time of night for the kits, "HH:mm" in the API server's local time.
  nightlyKitsAt       String    @default("03:00")
  /// When the kits last ran by themselves, so a night missed while the PC was off runs as
  /// soon as the app starts again, and only once a day.
  nightlyKitsRanAt    DateTime?
  /// Morning briefing: one summary a day in the bell and on your phone.
  briefingOn          Boolean   @default(true)
  /// Time of day for the briefing, "HH:mm" in the API server's local time.
  briefingAt          String    @default("07:30")
  /// When the last briefing went out, so it goes once a day.
  briefingSentAt      DateTime?
  /// Weekly report: on Sunday evening, your week in one summary (bell and phone push).
  weeklyReport        Boolean   @default(true)
  /// When the last weekly report went out, so a missed Sunday is sent when the app starts again.
  weeklySentAt        DateTime?
  /// Gmail moves a job by itself when an email is clearly a rejection or an interview invitation.
  mailAutoStatus      Boolean   @default(true)
  /// Your own fields for anything else forms ask: [{ "label": "Xing", "value": "…" }].
  customFields        Json      @default("[]")
  updatedAt           DateTime  @updatedAt
}

/// How your resume and cover letter PDFs look: the template, accent colour, type and photo.
/// One per user, created on first save; until then the defaults below apply.
model DocumentStyle {
  userId            Int      @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A template id: classic, modern, compact, sharp, bold, executive, leadership, jake, ats or mine (see apps/api/src/documents/templates.ts).
  resumeTemplate    String   @default("classic")
  /// auto (DIN 5008 for German letters), din or modern.
  coverLetterLayout String   @default("auto")
  /// Six hex digits, e.g. "1F4E79".
  accentColor       String   @default("1F4E79")
  /// auto (the template's own), sans or serif.
  font              String   @default("auto")
  showPhoto         Boolean  @default(false)
  /// JPEG or PNG, at most 2 MB.
  photo             Bytes?
  photoType         String?
  /// "My design": the look of your own resume as settings (see apps/api/src/documents/my-design.ts).
  myDesign          Json?
  /// Resume body text size in points (9 to 12); null is the template's own.
  fontSize          Float?
  /// Page margins in millimetres (10 to 25); null is the template's own.
  margin            Int?
  /// Line spacing, 1 to 1.4 (1 is the template's own).
  lineSpacing       Float    @default(1)
  /// Less space between jobs, bullets and sections, to fit more on a page.
  compact           Boolean  @default(false)
  /// Skills lines: index (aligned), lines (bold label, flowing text) or plain (as written).
  skillsStyle       String   @default("index")
  /// The label before the colon in a skills line in bold.
  skillsBold        Boolean  @default(true)
  /// Section titles: auto (the template's own), rule, bold or bar.
  headingStyle      String   @default("auto")
  /// Dates of a job: auto (the template's own), right or below.
  datesSide         String   @default("auto")
  /// Bullet shape: dot, dash or none.
  bulletStyle       String   @default("dot")
  updatedAt         DateTime @updatedAt
}

/// Your master resume in another language, e.g. German next to the English one. A job whose ad
/// is in that language is scored against it, and its Claude prompt starts from it.
model LanguageResume {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 639-1 code, e.g. "de".
  language  String
  text      String
  /// The uploaded PDF/DOCX's name, null when the text was pasted.
  fileName  String?
  file      Bytes?
  fileType  String?
  updatedAt DateTime @updatedAt

  @@id([userId, language])
}

/// Your master resume as the Resume builder edits it, one per language: sections you can move,
/// rename and hide (see apps/api/src/resume-builder/builder-doc.ts). Every save also writes the
/// resume as text into Profile.resumeText or LanguageResume.text, which the rest of the app reads.
model ResumeBuild {
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 639-1 code, e.g. "en".
  language   String
  doc        Json
  /// The resume text as the builder last read or wrote it. When the text on My profile differs
  /// (you uploaded a new file), the builder offers to read it again.
  syncedText String
  updatedAt  DateTime @updatedAt

  @@id([userId, language])
}

/// Your cover letter template in one language: written once, it starts each job's letter.
/// {company} and {job} in it become the job's company and title.
model CoverLetterTemplate {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 639-1 code, e.g. "en".
  language  String
  /// Paragraphs separated by a blank line.
  text      String   @default("")
  updatedAt DateTime @updatedAt

  @@id([userId, language])
}

enum MatcherResumeStatus {
  /// Resume-Matcher read the resume into sections; jobs can be matched against it.
  READY
  /// It has the file, but its AI could not read it (often a missing or wrong API key).
  FAILED
}

/// Your master resume's copy inside Resume-Matcher. Resume-Matcher has no users, so this row
/// is how we know which of its resumes is yours.
model MatcherResume {
  userId     Int                 @id
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Resume-Matcher's id for it. Null when the last send failed before it was stored.
  rmResumeId String?
  status     MatcherResumeStatus
  /// What went wrong, in words for the user. Null when READY.
  error      String?
  fileName   String
  syncedAt   DateTime
}

enum JobMatchStatus {
  /// Resume-Matcher is still working on it (about a minute).
  PENDING
  READY
  FAILED
}

/// How well one user's master resume fits one job, scored by Resume-Matcher. One row per user
/// and job; matching again overwrites it.
model JobMatch {
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              Int
  job                 Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId               String
  status              JobMatchStatus
  /// What went wrong, in words for the user. Null unless FAILED.
  error               String?
  /// Resume-Matcher's id for this job description, reused when matching again so it doesn't
  /// have to extract the keywords twice.
  rmJobId             String?
  /// Resume-Matcher's ATS score (0-100), a weighted mix of the five scores below.
  score               Float?
  /// Share of the job's keywords already in your resume, before any tailoring.
  keywordMatchBefore  Float?
  keywordMatch        Float?
  skillsCoverage      Float?
  /// Null when the posting has no clear job title.
  titleMatch          Float?
  sectionCompleteness Float?
  /// Null when the resume has fewer than two dates.
  dateConsistency     Float?
  /// Job keywords your resume lacks entirely.
  missingKeywords     String[]       @default([])
  /// Job keywords elsewhere in your resume that tailoring could bring forward.
  injectableKeywords  String[]       @default([])
  recommendations     String[]       @default([])
  /// The resume file this was scored against, so a newer upload shows the score is old.
  resumeFileName      String?
  startedAt           DateTime
  finishedAt          DateTime?

  @@id([userId, jobId])
}

/// Your resume rewritten for one job by Resume-Matcher, with a cover letter. The resume itself
/// stays in Resume-Matcher, which renders the PDFs; this row remembers which one is yours.
/// One per user and job; tailoring again replaces it.
model TailoredResume {
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  /// Same lifecycle as a match: PENDING while Resume-Matcher works, then READY or FAILED.
  status         JobMatchStatus
  error          String?
  /// Resume-Matcher's id for the tailored resume. Null until READY.
  rmResumeId     String?
  /// Resume-Matcher's id for the job text, reused when tailoring again.
  rmJobId        String?
  /// ATS score of the tailored version (0-100).
  score          Float?
  /// Null when the resume was tailored but the cover letter failed.
  coverLetter    String?
  /// The master resume file it was tailored from.
  resumeFileName String?
  startedAt      DateTime
  finishedAt     DateTime?

  @@id([userId, jobId])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  domain    String?
  logoUrl   String?
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id                String             @id @default(cuid())
  /// The JobHunter posting id. Null for jobs added by hand.
  externalId        String?            @unique
  source            JobSource
  title             String
  company           Company            @relation(fields: [companyId], references: [id])
  companyId         Int
  url               String?
  postedAt          DateTime
  seniority         String?
  jobFunction       String?
  skills            String[]
  city              String?
  location          String?
  countryCode       String?
  /// Language the posting is written in, as an ISO 639-1 code such as "de".
  language          String?
  salaryMinUsd      Int?
  salaryMaxUsd      Int?
  /// True when the salary is JobHunter's estimate rather than stated in the ad.
  salaryEstimated   Boolean            @default(false)
  /// Job board the posting was found on, e.g. "indeed".
  provider          String?
  workplace         Workplace?
  /// Read from the description when the job is saved. Null until it has been checked.
  visa              VisaSponsorship?
  industry          String?
  description       String?
  /// "active", "closed" (JobHunter says so) or "expired" (our still-open check found it closed).
  postingStatus     String             @default("active")
  /// When the still-open check last opened the job's link. Null until it has been checked.
  checkedAt         DateTime?
  lastCheck         PostingCheck?
  /// Why: a short code such as NOT_FOUND or SAYS_CLOSED (the web app turns it into words).
  checkReason       String?
  /// When the check first found the job closed.
  expiredAt         DateTime?
  /// The original API record, kept so new columns can be backfilled without re-fetching.
  raw               Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  hiddenBy          HiddenJob[]
  /// Who has this job on their list. Each user sees only the jobs they imported or added.
  listedFor         UserJob[]
  applications      Application[]
  applicationEvents ApplicationEvent[]
  matches           JobMatch[]
  tailored          TailoredResume[]
  removedTerms      RemovedTerm[]
  jobResumes        JobResume[]
  interviewPreps    InterviewPrep[]
  mailSuggestions   MailSuggestion[]
  applyQueue        ApplyQueueItem[]
  fits              JobFit[]
  jobLanguages      JobLanguages[]

  @@index([postedAt])
  @@index([companyId])
  @@index([checkedAt])
}

/// Where one user is with one job. No row means "not applied" (NONE is never stored), so
/// each user's tracker only holds the jobs they acted on.
model Application {
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              Int
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId               String
  status              ApplicationStatus
  /// When the status last changed. Marking a follow-up doesn't move it.
  statusChangedAt     DateTime          @default(now())
  /// When you last said you followed up on it (resets the "Follow up?" reminder).
  followedUpAt        DateTime?
  /// When your interview is (Interview tab). Setting it moves the job to Interviewing.
  interviewAt         DateTime?
  /// When the bell reminded you of that interview. Cleared when the date changes.
  interviewRemindedAt DateTime?
  /// The Google Calendar event made for that interview, when your calendar is connected.
  calendarEventId     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@id([userId, jobId])
  @@index([userId, status])
  @@index([interviewAt])
}

/// Each status a tracked job moved to, and when: the Funnel stats count how far your
/// applications got (a rejected job may have had an interview first). Removing a job from your
/// tracker removes its events.
model ApplicationEvent {
  id     Int               @id @default(autoincrement())
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  job    Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String
  status ApplicationStatus
  at     DateTime          @default(now())

  @@index([userId, jobId])
}

/// A job one user doesn't want to see. Other users still see it.
/// A job on one user's Job posts list. A job imported by two users is saved once and listed
/// for both, so one user's paid imports never show up for anyone else.
model UserJob {
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId   String
  addedAt DateTime @default(now())

  @@id([userId, jobId])
  @@index([jobId])
}

model HiddenJob {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  hiddenAt DateTime @default(now())

  /// One row per user and job, so hiding twice does nothing.
  @@id([userId, jobId])
}

/// One finished import from JobHunter. The latest complete run of a search tells the next
/// run where to start, so it only asks for postings discovered since then.
model SyncRun {
  id              Int          @id @default(autoincrement())
  /// The search's titles, skills and countries, normalized. Same search = same key.
  searchKey       String
  input           Json
  startedAt       DateTime
  finishedAt      DateTime     @default(now())
  /// True when every page was fetched (the run did not stop at maxPages).
  complete        Boolean
  fetched         Int
  created         Int
  updated         Int
  creditsCharged  Int?
  jobsAlreadyPaid Int?
  /// Where an incomplete run stopped; "Continue import" picks up from here.
  nextCursor      String?
  /// The discovered_at_gte the run sent. A continued run must send the same one.
  discoveredAtGte String?
  /// The saved search that ran this import, if any. Kept when the search is deleted.
  savedSearch     SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  savedSearchId   Int?
  /// True when the scheduler started this import, not a person.
  scheduled       Boolean      @default(false)
  /// Whose import it was: their token paid for it.
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?

  @@index([searchKey, startedAt])
  @@index([userId, finishedAt])
  @@index([savedSearchId])
}

enum ScheduleFrequency {
  OFF
  HOURLY
  DAILY
  WEEKDAYS
}

/// A JobHunter search you gave a name, so it can be run again in one click (and on a schedule later).
model SavedSearch {
  id                 Int               @id @default(autoincrement())
  /// Whose search it is. Its imports use this user's JobHunter token.
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int
  name               String
  source             ImportSource      @default(JOBHUNTER)
  /// Company career pages to read when the source is COMPANY_BOARDS, e.g. "greenhouse:stripe".
  boards             String[]          @default([])
  titles             String[]
  skills             String[]
  countryCodes       String[]
  locations          String[]
  /// ISO 639-1 codes of the posting's language, e.g. ["en", "de"].
  languages          String[]          @default([])
  skipFluentGerman   Boolean           @default(false)
  remoteOnly         Boolean           @default(false)
  excludeTitles      String[]          @default([])
  employmentTypes    String[]          @default([])
  /// Euros a year; the import converts it to the US dollars JobHunter filters in.
  minSalaryEur       Int?
  maxAgeDays         Int               @default(7)
  pageSize           Int               @default(25)
  maxPages           Int               @default(1)
  onlyNew            Boolean           @default(true)
  /// How often the scheduler runs this search by itself.
  schedule           ScheduleFrequency @default(OFF)
  /// Time of day for scheduled runs, "HH:mm" in the API server's local time.
  runAt              String            @default("07:00")
  /// When the scheduler will run it next. Null when the schedule is off.
  nextRunAt          DateTime?
  /// What happened at the last scheduled time, e.g. a skip because of the credit cap.
  scheduleNote       String?
  /// Autopilot: after each run, jobs that fit well go to the Apply queue and poor ones are hidden.
  autopilot          Boolean           @default(false)
  /// Autopilot queues a new job when its Fit % is at least this.
  autoQueueFitMin    Int               @default(75)
  /// Autopilot doesn't queue a job whose ad says there is no visa sponsorship.
  autoQueueNeedsVisa Boolean           @default(true)
  /// Autopilot hides a new job when its Fit % is under this. 0 hides nothing for its Fit.
  autoHideFitBelow   Int               @default(40)
  /// The most jobs Autopilot adds to your Apply queue in one day (all your searches together).
  autoQueueMaxPerDay Int               @default(10)
  runs               SyncRun[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([userId, name])
}

/// A skill or keyword you removed from a job's insights ("I don't have it" or "not relevant").
/// It leaves the copied prompt and stops counting against your score.
model RemovedTerm {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  /// The job it was removed from. Null means every job, e.g. a city that shows up as a keyword.
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  /// Lower case, as the insights show it.
  term      String
  createdAt DateTime @default(now())

  @@index([userId, jobId])
}

/// The resume you wrote for one job (e.g. with the copied Claude prompt), uploaded or pasted.
/// Scored against the job like your profile resume, so you see the before and after.
/// One per user and job; saving again replaces it.
model JobResume {
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String
  /// Plain text, read out of the file or pasted. This is what gets scored.
  text          String
  /// This copy as the Resume builder's sections (JSON); null until you open it there. Saving in
  /// the builder writes `text` from it, so scoring and the Apply kit read the same resume.
  doc           Json?
  /// The uploaded file, kept so you can download it again. Null when the text was pasted.
  fileName      String?
  file          Bytes?
  fileType      String?
  /// From the Apply kit reply: the cover letter and answers Claude wrote next to the resume.
  coverLetter   String          @default("")
  formAnswers   String          @default("")
  /// Claude's CHECK part of the reply: terms placed or skipped, stretches, questions for you.
  claudeCheck   String          @default("")
  /// Your decisions on Claude's questions for this job, as JSON: keep/soften/drop per stretch and
  /// an answer per question.
  claudeAnswers String          @default("{}")
  /// Apply kit score (0-100) of this resume, kept so the Job posts table can show it.
  score         Float?
  /// Resume-Matcher's ATS score for this resume: null until asked, cleared when the resume is saved again.
  aiStatus      JobMatchStatus?
  aiScore       Float?
  aiError       String?
  /// Job keywords this resume still lacks, and Resume-Matcher's tips, from the same check.
  aiMissing     String[]        @default([])
  aiTips        String[]        @default([])
  aiStartedAt   DateTime?
  updatedAt     DateTime        @updatedAt

  @@id([userId, jobId])
}

/// What Claude wrote to prepare you for an interview for one job (pasted back from the prompt in
/// the job popup). One per user and job; saving again replaces it.
model InterviewPrep {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  text      String
  updatedAt DateTime @updatedAt

  @@id([userId, jobId])
}

/// A job you lined up to apply for. Claude in Chrome works through the queue one posting at a
/// time; a job leaves it when you mark it Applied (or anything after) or remove it.
model ApplyQueueItem {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  addedAt  DateTime @default(now())
  /// Your order for the queue (1 first). Gaps are fine: the list is numbered 1, 2, 3 when read.
  position Int      @default(0)
  /// True when Autopilot added it, not you (counts against its daily limit).
  auto     Boolean  @default(false)

  @@id([userId, jobId])
}

/// An answer you gave to one of Claude's questions, kept for the next jobs. `key` is the question
/// in lower case without punctuation, so the same question is saved once.
/// One story of your story bank, in STAR form: what happened, what you had to do, what you did
/// and what came of it. Interview prep uses them for behavioural answers ("Tell me about a time…").
model Story {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  title      String
  situation  String   @default("")
  task       String   @default("")
  action     String   @default("")
  result     String   @default("")
  /// What you learned, or would do differently.
  reflection String   @default("")
  /// Skills or themes it shows, e.g. "leadership", "SQL".
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model SavedAnswer {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  key       String
  question  String
  answer    String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

/// The languages line of the Apply kit prompt, edited for one job. No row = your profile's
/// Languages.
model JobLanguages {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String
  text   String

  @@id([userId, jobId])
}

/// How well your profile resume fits a job (0-100): the job popup's score, worked out for every
/// job so the table can sort by it. No row when you have no resume yet.
model JobFit {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String
  score  Int
  /// A guess from the job title only, because the ad has no text. Shown as "~61%" and never
  /// used by automations (alerts, Autopilot, briefing, kits).
  estimate Boolean @default(false)

  @@id([userId, jobId])
  @@index([userId, score])
}

/// Whether you still have to answer a suggestion made from an employer's email.
enum SuggestionState {
  PENDING
  APPROVED
  DISMISSED
  /// The email was clear, so the app moved the job by itself (Undo in the bell).
  AUTO
}

/// A Gmail account one user connected (read-only). A user can connect several.
model GmailAccount {
  id           Int              @id @default(autoincrement())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  email        String
  /// Encrypted with AES-256-GCM (gmail/token-crypto.ts). Never returned by the API.
  refreshToken String
  connectedAt  DateTime         @default(now())
  lastSyncAt   DateTime?
  /// Why the last check failed (for example "access was revoked"), or null when it worked.
  lastError    String?
  suggestions  MailSuggestion[]

  @@unique([userId, email])
}

/// "This email looks like a rejection: move the job to Rejected?" The user approves or dismisses.
model MailSuggestion {
  id             Int                @id @default(autoincrement())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  account        GmailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      Int
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  /// Gmail's id for the email, so the same email is only suggested once per account.
  messageId      String
  fromAddress    String
  subject        String
  snippet        String
  receivedAt     DateTime
  /// The status the email points to.
  status         ApplicationStatus
  state          SuggestionState    @default(PENDING)
  /// AUTO: the status the job had before, so Undo can put it back.
  previousStatus ApplicationStatus?
  createdAt      DateTime           @default(now())

  @@unique([accountId, messageId])
  @@index([userId, state])
}

/// Something the app tells one user in the bell list, e.g. "3 new jobs match your search".
/// `kind` says which message it is and `data` holds its numbers and links, so the web app shows
/// it in the user's own language.
model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  /// NEW_MATCHES: a scheduled search found jobs that fit you.
  kind      String
  data      Json      @default("{}")
  /// When you opened the bell list after it came. Null = unread.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One line in a conversation between a user and the admins (Message Mohamed Faizel).
/// Each user has one conversation: their own messages and the admins' answers, in order.
model Message {
  id            Int       @id @default(autoincrement())
  /// Whose conversation this is: the user who wrote in, also on the admins' answers.
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  /// True for an admin's answer, false for the user's own message.
  fromAdmin     Boolean   @default(false)
  /// The name shown on an admin's answer, kept when that admin's account goes.
  authorName    String    @default("")
  /// QUESTION, SUGGESTION or BROKEN on a user's message. Null on answers.
  topic         String?
  body          String
  /// When the user saw this answer. Null = unread (only on answers).
  readByUserAt  DateTime?
  /// When an admin opened this message. Null = unread (only on user messages).
  readByAdminAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Who can make a new account (Admin › Sign-up & access).
enum SignupMode {
  /// Anyone with the link.
  OPEN
  /// Only with an invite link.
  INVITE
  /// No new accounts; existing ones still log in.
  CLOSED
}

/// The server's settings that admins change in the app. One row (id 1), made the first time it
/// is read, with its starting values from .env (ALLOW_SIGNUP, DAILY_CREDIT_CAP).
model AppSetting {
  id               Int        @id @default(1)
  signupMode       SignupMode @default(OPEN)
  /// Per user and day: saved searches that run on their own stop before going over it.
  dailyCreditCap   Int        @default(100)
  /// The most saved searches one user can keep.
  maxSavedSearches Int        @default(10)
  /// Off pauses every saved search's schedule (SCHEDULER_ENABLED=false in .env wins).
  schedulerOn      Boolean    @default(true)
  /// Off stops the nightly "still open?" check (STILL_OPEN_CHECK_ENABLED=false in .env wins).
  stillOpenOn      Boolean    @default(true)
  /// Key pool: a user's first token request gets a free key at once, without an admin.
  poolAutoApprove  Boolean    @default(true)
  /// Key pool: how many credits each user may spend with a lent key.
  poolKeyLimit     Int        @default(500)
  updatedAt        DateTime   @updatedAt
}

/// A sign-up link an admin made: /signup?invite=<token>. Works in every mode except CLOSED.
model Invite {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  createdAt  DateTime  @default(now())
  /// Null = never expires.
  expiresAt  DateTime?
  /// Null = any number of times.
  maxUses    Int?
  uses       Int       @default(0)
  /// Set when an admin cancels the link.
  canceledAt DateTime?
}

/// A JobHunter token in the admins' Key pool (Admin › Key pool), lent to one user at a time.
/// Stored encrypted like ApiKey and never shown again to anyone, not even a part of it.
model PoolKey {
  id          Int       @id @default(autoincrement())
  /// Encrypted with AES-256-GCM (api-keys.service.ts).
  secret      String
  /// A keyed hash of the token, so the same token can't be added twice.
  fingerprint String    @unique
  /// The admin's note, e.g. "Seeker plan, Nov 2026".
  note        String    @default("")
  /// JobHunter credits left on the key, as its last answer said. 0 = empty.
  credits     Int?
  /// Who has it now. Null = free. One key per user.
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      Int?      @unique
  assignedAt  DateTime?
  /// Credits its holder spent since they got it, for the per-user limit (AppSetting.poolKeyLimit).
  used        Int       @default(0)
  createdAt   DateTime  @default(now())
}

enum KeyRequestStatus {
  PENDING
  APPROVED
  DENIED
  /// The user took it back, or saved their own token.
  CANCELED
}

/// A user asking the admins for a token from the Key pool.
model KeyRequest {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  status    KeyRequestStatus @default(PENDING)
  /// The admin's note when saying no.
  note      String?
  /// Approved by the server (a first request with auto-approve on), not by an admin.
  auto      Boolean          @default(false)
  createdAt DateTime         @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// A phone that gets push messages (Expo push token), e.g. the morning briefing.
model PushToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  /// "ExponentPushToken[…]". One phone belongs to one user at a time.
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Your Google Calendar, connected in Settings > Gmail: interview dates become events there.
model GoogleCalendar {
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int      @id
  email        String
  /// Encrypted like a Gmail token (gmail/token-crypto.ts). Never returned by the API.
  refreshToken String
  connectedAt  DateTime @default(now())
  /// Why the last change to the calendar failed, or null when it worked.
  lastError    String?
}
