// Database schema. After editing, run `pnpm --filter @jobsearch/api db:migrate` to create a migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Where a job came from.
enum JobSource {
  JOBSPIPE
  MANUAL
}

enum Workplace {
  ONSITE
  HYBRID
  REMOTE
}

/// Your own progress on a job. Separate from `postingStatus`, which is whether the ad is still open.
enum ApplicationStatus {
  NONE
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// ADMIN can import from JobsPipe and manage saved searches (it spends the server's credits).
/// The first account to sign up becomes ADMIN; everyone after that is a USER.
enum Role {
  ADMIN
  USER
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  name         String
  /// argon2id hash. The password itself is never stored.
  passwordHash String
  role         Role        @default(USER)
  profile      Profile?
  hiddenJobs   HiddenJob[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

/// What you're looking for and your master resume. One per user, created on first save.
model Profile {
  userId          Int      @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String   @default("")
  targetRoles     String[] @default([])
  locations       String[] @default([])
  skills          String[] @default([])
  yearsExperience Int?
  linkedinUrl     String?
  githubUrl       String?
  websiteUrl      String?
  /// Plain text of your master resume, from an uploaded PDF/DOCX or typed in.
  resumeText      String   @default("")
  resumeFileName  String?
  updatedAt       DateTime @updatedAt
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  domain    String?
  logoUrl   String?
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id                String            @id @default(cuid())
  /// The JobsPipe posting id. Null for jobs added by hand.
  externalId        String?           @unique
  source            JobSource
  title             String
  company           Company           @relation(fields: [companyId], references: [id])
  companyId         Int
  url               String?
  postedAt          DateTime
  seniority         String?
  jobFunction       String?
  skills            String[]
  city              String?
  location          String?
  countryCode       String?
  salaryMinUsd      Int?
  salaryMaxUsd      Int?
  /// True when the salary is JobsPipe's estimate rather than stated in the ad.
  salaryEstimated   Boolean           @default(false)
  /// Job board the posting was found on, e.g. "indeed".
  provider          String?
  workplace         Workplace?
  industry          String?
  description       String?
  postingStatus     String            @default("active")
  applicationStatus ApplicationStatus @default(NONE)
  /// The original API record, kept so new columns can be backfilled without re-fetching.
  raw               Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  hiddenBy          HiddenJob[]

  @@index([postedAt])
  @@index([companyId])
  @@index([applicationStatus])
}

/// A job one user doesn't want to see. Other users still see it.
model HiddenJob {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  hiddenAt DateTime @default(now())

  /// One row per user and job, so hiding twice does nothing.
  @@id([userId, jobId])
}

/// One finished import from JobsPipe. The latest complete run of a search tells the next
/// run where to start, so it only asks for postings discovered since then.
model SyncRun {
  id              Int          @id @default(autoincrement())
  /// The search's titles, skills and countries, normalized. Same search = same key.
  searchKey       String
  input           Json
  startedAt       DateTime
  finishedAt      DateTime     @default(now())
  /// True when every page was fetched (the run did not stop at maxPages).
  complete        Boolean
  fetched         Int
  created         Int
  updated         Int
  creditsCharged  Int?
  jobsAlreadyPaid Int?
  /// Where an incomplete run stopped; "Continue import" picks up from here.
  nextCursor      String?
  /// The discovered_at_gte the run sent. A continued run must send the same one.
  discoveredAtGte String?
  /// The saved search that ran this import, if any. Kept when the search is deleted.
  savedSearch     SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  savedSearchId   Int?
  /// True when the scheduler started this import, not a person.
  scheduled       Boolean      @default(false)

  @@index([searchKey, startedAt])
  @@index([savedSearchId])
}

enum ScheduleFrequency {
  OFF
  HOURLY
  DAILY
  WEEKDAYS
}

/// A JobsPipe search you gave a name, so it can be run again in one click (and on a schedule later).
model SavedSearch {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  titles       String[]
  skills       String[]
  countryCodes String[]
  locations    String[]
  maxAgeDays   Int               @default(7)
  pageSize     Int               @default(25)
  maxPages     Int               @default(1)
  onlyNew      Boolean           @default(true)
  /// How often the scheduler runs this search by itself.
  schedule     ScheduleFrequency @default(OFF)
  /// Time of day for scheduled runs, "HH:mm" in the API server's local time.
  runAt        String            @default("07:00")
  /// When the scheduler will run it next. Null when the schedule is off.
  nextRunAt    DateTime?
  /// What happened at the last scheduled time, e.g. a skip because of the credit cap.
  scheduleNote String?
  runs         SyncRun[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}
