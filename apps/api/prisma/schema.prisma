// Database schema. After editing, run `pnpm --filter @jobsearch/api db:migrate` to create a migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Where a job came from.
enum JobSource {
  JOBSPIPE
  MANUAL
}

/// What a job ad says about visa sponsorship (or relocation help).
enum VisaSponsorship {
  OFFERS
  NO
  NOT_STATED
}

enum Workplace {
  ONSITE
  HYBRID
  REMOTE
}

/// Your own progress on a job. Separate from `postingStatus`, which is whether the ad is still open.
enum ApplicationStatus {
  NONE
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// ADMIN can import from JobsPipe and manage saved searches (it spends the server's credits).
/// The first account to sign up becomes ADMIN; everyone after that is a USER.
enum Role {
  ADMIN
  USER
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String
  /// argon2id hash. The password itself is never stored.
  passwordHash    String
  role            Role             @default(USER)
  profile         Profile?
  languageResumes LanguageResume[]
  documentStyle   DocumentStyle?
  hiddenJobs      HiddenJob[]
  applications    Application[]
  matcherResume   MatcherResume?
  jobMatches      JobMatch[]
  tailored        TailoredResume[]
  removedTerms    RemovedTerm[]
  jobResumes      JobResume[]
  applyQueue      ApplyQueueItem[]
  jobFits         JobFit[]
  /// When you last opened Job posts (any page load counts). A gap of 30+ minutes starts a new visit.
  jobsLastSeenAt  DateTime?
  /// Jobs imported after this are "New" for this visit: the end of your previous visit.
  jobsNewSince    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// What you're looking for and your master resume. One per user, created on first save.
model Profile {
  userId            Int       @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String    @default("")
  targetRoles       String[]  @default([])
  locations         String[]  @default([])
  skills            String[]  @default([])
  /// Languages you speak with your real level, e.g. "German A2". Copied into the resume prompt.
  languages         String[]  @default([])
  yearsExperience   Int?
  linkedinUrl       String?
  githubUrl         String?
  websiteUrl        String?
  /// Plain text of your master resume, from an uploaded PDF/DOCX or typed in.
  resumeText        String    @default("")
  /// The language your master resume is written in (ISO 639-1, e.g. "en"). Resumes in other
  /// languages are in LanguageResume.
  resumeLanguage    String    @default("en")
  resumeFileName    String?
  /// The uploaded PDF/DOCX itself, kept so it can be sent to Resume-Matcher (max 5 MB).
  resumeFile        Bytes?
  resumeFileType    String?
  resumeUploadedAt  DateTime?
  // Personal details forms ask for. Empty = not given. User.name stays the display name;
  // saving a first and last name updates it.
  firstName         String    @default("")
  lastName          String    @default("")
  /// female, male, diverse or not_specified; empty = not given. Codes, so any language can
  /// show its own words.
  gender            String    @default("")
  /// ISO date "YYYY-MM-DD", empty = not given.
  dateOfBirth       String    @default("")
  nationality       String    @default("")
  // Application answers: the facts every application form asks for. The Apply kit copies them
  // into the Claude prompt and the page Claude in Chrome fills forms from. Empty = not given.
  phone             String    @default("")
  address           String    @default("")
  workPermit        String    @default("")
  noticePeriod      String    @default("")
  salaryExpectation String    @default("")
  relocation        String    @default("")
  /// e.g. "Full-time".
  employmentType    String    @default("")
  /// e.g. "Remote or hybrid".
  workplacePreference String  @default("")
  /// e.g. "Class B".
  drivingLicence    String    @default("")
  /// Free text: short answers you reuse, like why you are looking for a new job.
  applicationNotes  String    @default("")
  /// Your own fields for anything else forms ask: [{ "label": "Xing", "value": "…" }].
  customFields      Json      @default("[]")
  updatedAt         DateTime  @updatedAt
}

/// How your resume and cover letter PDFs look: the template, accent colour, type and photo.
/// One per user, created on first save; until then the defaults below apply.
model DocumentStyle {
  userId            Int      @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// classic, modern or compact (see apps/api/src/documents/templates.ts).
  resumeTemplate    String   @default("classic")
  /// auto (DIN 5008 for German letters), din or modern.
  coverLetterLayout String   @default("auto")
  /// Six hex digits, e.g. "1F4E79".
  accentColor       String   @default("1F4E79")
  /// auto (the template's own), sans or serif.
  font              String   @default("auto")
  showPhoto         Boolean  @default(false)
  /// JPEG or PNG, at most 2 MB.
  photo             Bytes?
  photoType         String?
  updatedAt         DateTime @updatedAt
}

/// Your master resume in another language, e.g. German next to the English one. A job whose ad
/// is in that language is scored against it, and its Claude prompt starts from it.
model LanguageResume {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 639-1 code, e.g. "de".
  language  String
  text      String
  /// The uploaded PDF/DOCX's name, null when the text was pasted.
  fileName  String?
  file      Bytes?
  fileType  String?
  updatedAt DateTime @updatedAt

  @@id([userId, language])
}

enum MatcherResumeStatus {
  /// Resume-Matcher read the resume into sections; jobs can be matched against it.
  READY
  /// It has the file, but its AI could not read it (often a missing or wrong API key).
  FAILED
}

/// Your master resume's copy inside Resume-Matcher. Resume-Matcher has no users, so this row
/// is how we know which of its resumes is yours.
model MatcherResume {
  userId     Int                 @id
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Resume-Matcher's id for it. Null when the last send failed before it was stored.
  rmResumeId String?
  status     MatcherResumeStatus
  /// What went wrong, in words for the user. Null when READY.
  error      String?
  fileName   String
  syncedAt   DateTime
}

enum JobMatchStatus {
  /// Resume-Matcher is still working on it (about a minute).
  PENDING
  READY
  FAILED
}

/// How well one user's master resume fits one job, scored by Resume-Matcher. One row per user
/// and job; matching again overwrites it.
model JobMatch {
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              Int
  job                 Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId               String
  status              JobMatchStatus
  /// What went wrong, in words for the user. Null unless FAILED.
  error               String?
  /// Resume-Matcher's id for this job description, reused when matching again so it doesn't
  /// have to extract the keywords twice.
  rmJobId             String?
  /// Resume-Matcher's ATS score (0-100), a weighted mix of the five scores below.
  score               Float?
  /// Share of the job's keywords already in your resume, before any tailoring.
  keywordMatchBefore  Float?
  keywordMatch        Float?
  skillsCoverage      Float?
  /// Null when the posting has no clear job title.
  titleMatch          Float?
  sectionCompleteness Float?
  /// Null when the resume has fewer than two dates.
  dateConsistency     Float?
  /// Job keywords your resume lacks entirely.
  missingKeywords     String[]       @default([])
  /// Job keywords elsewhere in your resume that tailoring could bring forward.
  injectableKeywords  String[]       @default([])
  recommendations     String[]       @default([])
  /// The resume file this was scored against, so a newer upload shows the score is old.
  resumeFileName      String?
  startedAt           DateTime
  finishedAt          DateTime?

  @@id([userId, jobId])
}

/// Your resume rewritten for one job by Resume-Matcher, with a cover letter. The resume itself
/// stays in Resume-Matcher, which renders the PDFs; this row remembers which one is yours.
/// One per user and job; tailoring again replaces it.
model TailoredResume {
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  /// Same lifecycle as a match: PENDING while Resume-Matcher works, then READY or FAILED.
  status         JobMatchStatus
  error          String?
  /// Resume-Matcher's id for the tailored resume. Null until READY.
  rmResumeId     String?
  /// Resume-Matcher's id for the job text, reused when tailoring again.
  rmJobId        String?
  /// ATS score of the tailored version (0-100).
  score          Float?
  /// Null when the resume was tailored but the cover letter failed.
  coverLetter    String?
  /// The master resume file it was tailored from.
  resumeFileName String?
  startedAt      DateTime
  finishedAt     DateTime?

  @@id([userId, jobId])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  domain    String?
  logoUrl   String?
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id              String           @id @default(cuid())
  /// The JobsPipe posting id. Null for jobs added by hand.
  externalId      String?          @unique
  source          JobSource
  title           String
  company         Company          @relation(fields: [companyId], references: [id])
  companyId       Int
  url             String?
  postedAt        DateTime
  seniority       String?
  jobFunction     String?
  skills          String[]
  city            String?
  location        String?
  countryCode     String?
  /// Language the posting is written in, as an ISO 639-1 code such as "de".
  language        String?
  salaryMinUsd    Int?
  salaryMaxUsd    Int?
  /// True when the salary is JobsPipe's estimate rather than stated in the ad.
  salaryEstimated Boolean          @default(false)
  /// Job board the posting was found on, e.g. "indeed".
  provider        String?
  workplace       Workplace?
  /// Read from the description when the job is saved. Null until it has been checked.
  visa            VisaSponsorship?
  industry        String?
  description     String?
  postingStatus   String           @default("active")
  /// The original API record, kept so new columns can be backfilled without re-fetching.
  raw             Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  hiddenBy        HiddenJob[]
  applications    Application[]
  matches         JobMatch[]
  tailored        TailoredResume[]
  removedTerms    RemovedTerm[]
  jobResumes      JobResume[]
  applyQueue      ApplyQueueItem[]
  fits            JobFit[]

  @@index([postedAt])
  @@index([companyId])
}

/// Where one user is with one job. No row means "not applied" (NONE is never stored), so
/// each user's tracker only holds the jobs they acted on.
model Application {
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  status    ApplicationStatus
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@id([userId, jobId])
  @@index([userId, status])
}

/// A job one user doesn't want to see. Other users still see it.
model HiddenJob {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  hiddenAt DateTime @default(now())

  /// One row per user and job, so hiding twice does nothing.
  @@id([userId, jobId])
}

/// One finished import from JobsPipe. The latest complete run of a search tells the next
/// run where to start, so it only asks for postings discovered since then.
model SyncRun {
  id              Int          @id @default(autoincrement())
  /// The search's titles, skills and countries, normalized. Same search = same key.
  searchKey       String
  input           Json
  startedAt       DateTime
  finishedAt      DateTime     @default(now())
  /// True when every page was fetched (the run did not stop at maxPages).
  complete        Boolean
  fetched         Int
  created         Int
  updated         Int
  creditsCharged  Int?
  jobsAlreadyPaid Int?
  /// Where an incomplete run stopped; "Continue import" picks up from here.
  nextCursor      String?
  /// The discovered_at_gte the run sent. A continued run must send the same one.
  discoveredAtGte String?
  /// The saved search that ran this import, if any. Kept when the search is deleted.
  savedSearch     SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  savedSearchId   Int?
  /// True when the scheduler started this import, not a person.
  scheduled       Boolean      @default(false)

  @@index([searchKey, startedAt])
  @@index([savedSearchId])
}

enum ScheduleFrequency {
  OFF
  HOURLY
  DAILY
  WEEKDAYS
}

/// A JobsPipe search you gave a name, so it can be run again in one click (and on a schedule later).
model SavedSearch {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  titles           String[]
  skills           String[]
  countryCodes     String[]
  locations        String[]
  /// ISO 639-1 codes of the posting's language, e.g. ["en", "de"].
  languages        String[]          @default([])
  skipFluentGerman Boolean           @default(false)
  remoteOnly       Boolean           @default(false)
  excludeTitles    String[]          @default([])
  employmentTypes  String[]          @default([])
  /// Euros a year; the import converts it to the US dollars JobsPipe filters in.
  minSalaryEur     Int?
  maxAgeDays       Int               @default(7)
  pageSize         Int               @default(25)
  maxPages         Int               @default(1)
  onlyNew          Boolean           @default(true)
  /// How often the scheduler runs this search by itself.
  schedule         ScheduleFrequency @default(OFF)
  /// Time of day for scheduled runs, "HH:mm" in the API server's local time.
  runAt            String            @default("07:00")
  /// When the scheduler will run it next. Null when the schedule is off.
  nextRunAt        DateTime?
  /// What happened at the last scheduled time, e.g. a skip because of the credit cap.
  scheduleNote     String?
  runs             SyncRun[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// A skill or keyword you removed from a job's insights ("I don't have it" or "not relevant").
/// It leaves the copied prompt and stops counting against your score.
model RemovedTerm {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  /// The job it was removed from. Null means every job, e.g. a city that shows up as a keyword.
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  /// Lower case, as the insights show it.
  term      String
  createdAt DateTime @default(now())

  @@index([userId, jobId])
}

/// The resume you wrote for one job (e.g. with the copied Claude prompt), uploaded or pasted.
/// Scored against the job like your profile resume, so you see the before and after.
/// One per user and job; saving again replaces it.
model JobResume {
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  /// Plain text, read out of the file or pasted. This is what gets scored.
  text        String
  /// The uploaded file, kept so you can download it again. Null when the text was pasted.
  fileName    String?
  file        Bytes?
  fileType    String?
  /// From the Apply kit reply: the cover letter and answers Claude wrote next to the resume.
  coverLetter String   @default("")
  formAnswers String   @default("")
  updatedAt   DateTime @updatedAt

  @@id([userId, jobId])
}

/// A job you lined up to apply for. Claude in Chrome works through the queue one posting at a
/// time; a job leaves it when you mark it Applied (or anything after) or remove it.
model ApplyQueueItem {
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId   String
  addedAt DateTime @default(now())

  @@id([userId, jobId])
}

/// How well your profile resume fits a job (0-100): the job popup's score, worked out for every
/// job so the table can sort by it. No row when you have no resume yet.
model JobFit {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String
  score  Int

  @@id([userId, jobId])
  @@index([userId, score])
}
